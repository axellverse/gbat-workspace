# Deployment settings. None of these are needed to run locally.

# ---------------------------------------------------------------------------
# Pick ONE of the two ways to configure a deployment.
# ---------------------------------------------------------------------------

# A) No persistent disk (Hostinger shared, Vercel, Netlify, anywhere).
#    The entire configuration as one line. Generate it from
#    Settings -> Export configuration, then paste it here.
#    Settings becomes read-only: to change anything, update this and redeploy.
GBAT_SECRETS=

# B) A persistent disk. Point this at a mounted volume and Settings stays
#    editable, with changes saved straight to Secret.json.
#    Leave it unset to use the project directory (local development).
GBAT_DATA_DIR=/data

# The password for a fresh instance, so a deployment never comes up on the
# default that ships in this repo. Only used until Secret.json has one of its
# own; after that, change it in Settings.
GBAT_PASSWORD=

# Optional first-boot seeds, if you would rather not type keys into the UI.
# Anything set in Secret.json always wins over these.
YUNWU_API_KEY=
YUNWU_BASE_URL=
OPENAI_API_KEY=
ZYTE_API_KEY=
